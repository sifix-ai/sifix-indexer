{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "ponder.config.ts",
    "ponder.schema.ts",
    "src/index.ts",
    "scripts/**/*.ts",
    "ponder-env.d.ts"
  ]
}
